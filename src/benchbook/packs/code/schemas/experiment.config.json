{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "code experiment config",
  "description": "One attempt at a piece. code_ref holds the commit. approach and paths are optional and ignored by the dedup key.",
  "type": "object",
  "required": [
    "piece",
    "checks"
  ],
  "properties": {
    "piece": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 1
    },
    "approach": {
      "type": "string",
      "maxLength": 200
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 100
    }
  }
}
