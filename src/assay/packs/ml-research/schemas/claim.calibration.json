{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "noise calibration of a partition (written by the referee)",
  "type": "object",
  "required": [
    "partition",
    "sigma",
    "epsilon",
    "experiment_ids"
  ],
  "properties": {
    "partition": {
      "type": "string"
    },
    "sigma": {
      "type": [
        "number",
        "null"
      ]
    },
    "epsilon": {
      "type": "number"
    },
    "experiment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "n": {
      "type": "integer"
    }
  }
}
