+def test_run_length():
+    assert run_length([]) == []
+    assert run_length([1, 1, 2, 1]) == [(1, 2), (2, 1), (1, 1)]
+    assert run_length([[1], [1], [2]]) == [([1], 2), ([2], 1)]
