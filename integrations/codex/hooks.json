{
  "description": "benchbook check recording, worker reports and boundary context. See integrations/codex/README.md.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "benchbook hook bash-result --harness codex",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "benchbook hook notes --harness codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "benchbook hook subagent-stop --harness codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "benchbook hook session-start --harness codex",
            "timeout": 7,
            "type": "command"
          }
        ]
      }
    ]
  }
}
