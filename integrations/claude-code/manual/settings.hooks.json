{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "assay-worker",
        "hooks": [
          {
            "type": "command",
            "command": "assay hook subagent-stop",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "assay hook subagent-handback",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
